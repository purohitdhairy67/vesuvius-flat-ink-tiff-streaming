+def test_streamed_tiff_matches_ram_with_partial_tiles_and_empty_blocks(tmp_path):
+    fixture = Path(__file__).parent / 'fixtures/ink_roi_case.npz'
+    with np.load(fixture) as saved:
+        probability = saved['probability'].astype(np.float32)
+    shape = probability.shape
+    tile_shape = (32, 32)
+    blocks = infer.iter_blocks(shape, patch_size=32, stride=17)
+    weight = infer.compute_importance_map_2d(patch_size=tile_shape, mode='hann').numpy()
+
+    def consume(accumulator):
+        for block in blocks:
+            y0, x0, h, w = block.y0, block.x0, block.valid_h, block.valid_w
+            if x0 >= 32:
+                accumulator.skip_tile(y0=y0, x0=x0, valid_h=h, valid_w=w)
+            else:
+                accumulator.add_tile(
+                    y0=y0, x0=x0, tile=probability[y0:y0+h, x0:x0+w],
+                    tile_weights=weight[:h, :w],
+                )
+
+    outputs = [tmp_path / 'ram.tif', tmp_path / 'streamed.tif']
+    for output, limit in zip(outputs, [1, 0]):
+        infer.write_flat_output(
+            output_path=output, output_shape=shape, tile_shape=tile_shape,
+            blocks=blocks, max_ram_accumulation_gb=limit, consume=consume,
+        )
+
+    a, b = (tifffile.imread(path) for path in outputs)
+    assert a.any() and not a[:, -1].any()
+    np.testing.assert_array_equal(a, b)
+    with tifffile.TiffFile(outputs[1]) as tiff:
+        assert tiff.pages[0].is_tiled
+        assert tiff.pages[0].compression.name == 'LZW'
+
